---
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { TURNSTILE_SITEKEY } from '../lib/config';
import { loadSite } from '../lib/content';
import { NO_SPEAKER } from '../lib/types';

const DATA_DIR = join(process.cwd(), 'src', 'data');
const { scenes, takes, dialects, places } = loadSite(DATA_DIR);

// 每一拍给一句普通话参考——投稿人照着意思用自己的话说，而不是照着某个
// 方言版本念。念别人的版本会把那个方言的措辞带进来，就不是他自己的话了。
const list = Array.from(scenes.values()).map((scene) => ({
  scene,
  // 空拍（speakerRole: none）不列出来——那一拍没人说话，给个录音按钮
  // 等于请人录一段空气，而且下面 mandarin 显示的是「门关上的声音」这种
  // 舞台提示，照着念就更荒唐了。
  beats: scene.beats
    .filter((b) => b.speakerRole !== NO_SPEAKER)
    .map((b) => {
      const ref = takes.find((p) => p.sceneId === scene.id)?.lines.find((l) => l.beatId === b.id);
      return { beat: b, role: scene.roles[b.speakerRole], mandarin: ref?.textMandarin ?? '' };
    }),
}));
---
<Base title="录一个真的 — 各说各话" description="用你自己的方言录一遍，直接在网页上传，不用走 GitHub。">
  <header class="top">
    <a class="home" href="/">← 各说各话</a>
    <h1>录一个真的</h1>
    <p class="lede">
      站上现在全是 AI 合成的区级口音。你一开口，就带着你那个村的坐标——
      <strong>那才是这个项目想要的东西</strong>。
    </p>
  </header>

  <section class="who">
    <label>
      <span class="k">你是哪儿人 <em>必填</em></span>
      <input id="place" type="text" placeholder="山东德州 · 陵城区 · 糜镇" autocomplete="off" />
      <span class="hint">越细越好。乡镇比县好，县比市好——录音会挂到你写的这个点上。</span>
    </label>
    <label>
      <span class="k">怎么找到你 <em>选填</em></span>
      <input id="contact" type="text" placeholder="邮箱 / GitHub 用户名，用于回来问你一句" autocomplete="off" />
    </label>
  </section>

  <section class="how">
    <h2>怎么录</h2>
    <ol>
      <li>看这一拍要表达什么意思（下面每条都给了普通话对照）。</li>
      <li><strong>别照着念</strong>——用你们那儿真会说的话说一遍，包括脏字。
        <a href="/swearing/">为什么脏话要留着 →</a></li>
      <li>点「开始录」，说完点「停」，听一下，觉得行就传。</li>
    </ol>
    <p class="fine">
      录音只上传、不公开：会有人先听过，确认是本人本地口音，才会替换掉那条 AI 版，
      并把这份演绎标成「真人录音」。传上来的东西不会被别人直接访问到。
    </p>
  </section>

  <div class="ts" id="ts-host" aria-label="人机验证"></div>

  {list.map(({ scene, beats }) => (
    <section class="scene" data-scene={scene.id}>
      <h2>{scene.title}</h2>
      <p class="sit">{scene.situation}</p>
      {beats.map(({ beat, role, mandarin }) => (
        <div class="beat" data-scene={scene.id} data-beat={beat.id}>
          <div class="meta">
            <span class="n">{String(beat.order).padStart(2, '0')}</span>
            <span class="intent">{beat.intent}</span>
            {role && <span class="role">{role.name}</span>}
          </div>
          {mandarin && <p class="ref">{mandarin}</p>}
          <div class="ctl">
            <button class="rec" type="button">● 开始录</button>
            <label class="pick">
              选个文件
              <input type="file" accept="audio/*" hidden />
            </label>
            <audio class="prev" controls hidden></audio>
            <button class="send" type="button" hidden>上传这一拍</button>
            <span class="status" role="status"></span>
          </div>
        </div>
      ))}
    </section>
  ))}
</Base>

<script define:vars={{ sitekey: TURNSTILE_SITEKEY }}>
  window.__SITEKEY__ = sitekey;
</script>
<script>
  import { initRecorder } from '../scripts/recorder';
  // sitekey 由上面那段 define:vars 的内联脚本挂在 window 上——
  // define:vars 不作用于模块脚本，模块里直接写 sitekey 会是 undefined
  initRecorder(document, (window as unknown as { __SITEKEY__?: string }).__SITEKEY__);
</script>

<style>
  .top { padding: 56px 0 8px; }
  .home { font-family: "Noto Sans SC", sans-serif; font-size: 13px; color: var(--dust); text-decoration: none; letter-spacing: .1em; }
  .home:hover { color: var(--cut-lit); }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(34px, 6vw, 54px); color: var(--cut); margin: 14px 0 10px; }
  .lede { max-width: 34em; margin: 0; color: var(--ink-2); }
  .lede strong, .body strong { color: var(--cut-lit); }

  .who { display: grid; gap: 14px; margin: 30px 0 8px; max-width: 36em; }
  .who label { display: flex; flex-direction: column; gap: 6px; }
  .k { font-family: "Noto Sans SC", sans-serif; font-size: 13px; color: var(--dust); letter-spacing: .06em; }
  .k em { font-style: normal; color: var(--cut); font-size: 11.5px; margin-left: 6px; }
  .who input {
    font: inherit; font-size: 15px; padding: 11px 14px;
    background: var(--night-2); border: 1px solid var(--rule); color: var(--body-fg);
  }
  .who input:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 1px; }
  .hint { font-family: "Noto Sans SC", sans-serif; font-size: 12px; color: var(--dust); }

  .how { margin: 34px 0 10px; max-width: 36em; }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: 24px; color: var(--cut); margin: 0 0 12px; }
  .how ol { padding-left: 1.2em; margin: 0 0 14px; color: var(--ink-2); }
  .how li { margin-bottom: 6px; }
  .how a { color: var(--cut-lit); }
  .fine { font-size: 13px; color: var(--dust); border-left: 3px solid var(--rule); padding-left: 14px; margin: 0; }

  .ts { margin: 18px 0 6px; min-height: 0; }
  .scene { margin-top: 44px; }
  .sit { color: var(--ink-2); margin: 0 0 18px; }
  .beat { border-top: 1px solid var(--rule); padding: 18px 0; }
  .meta { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .n { font-family: "Noto Sans SC", sans-serif; font-size: 12px; color: var(--dust); font-variant-numeric: tabular-nums; }
  .intent { font-size: 15px; color: var(--body-fg); }
  .role { font-family: "Noto Sans SC", sans-serif; font-size: 11.5px; color: var(--dust); border: 1px solid var(--rule); padding: 1px 7px; }
  .ref { margin: 8px 0 12px; color: var(--ink-2); font-size: 15px; }

  .ctl { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ctl button, .pick {
    font-family: "Noto Sans SC", sans-serif; font-size: 13.5px; cursor: pointer;
    border: 1px solid var(--cut); background: transparent; color: var(--cut);
    padding: 8px 16px; border-radius: 2px; transition: background .18s, color .18s;
  }
  .ctl button:hover, .pick:hover { background: var(--cut); color: var(--paper); }
  .ctl button:focus-visible, .pick:focus-within { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .ctl button[disabled] { opacity: .45; cursor: default; }
  .ctl button.on { background: var(--cut); color: var(--paper); }
  .send { border-style: dashed; }
  .prev { height: 34px; max-width: 260px; }
  .status { font-family: "Noto Sans SC", sans-serif; font-size: 12.5px; color: var(--dust); }
  .status.ok { color: var(--cut); }
  .status.bad { color: var(--cut-lit); }
</style>
