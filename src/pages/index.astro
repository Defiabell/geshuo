---
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/content';
import { identityOf } from '../lib/identity';

// 首页不走 getStaticPaths，属于顶层 frontmatter 作用域，可以直接用
// process.cwd() 声明常量——理由同 [scene]/compare/[beat].astro 里的注释：
// 相对 new URL(...) + import.meta.url 的写法在 astro build 时会指向
// rolldown 打包产物自身的位置，路径深度算不对。
const DATA_DIR = join(process.cwd(), 'src', 'data');
const { scenes, takes, dialects, places } = loadSite(DATA_DIR);

// 一句话挑战不混进「挑一出戏」——它是低门槛入口，戏是深度内容，
// 摆在一起会让人以为一句话也要录五条。
const weeklies = Array.from(scenes.values())
  .filter((s) => s.weekly)
  .sort((a, b) => (a.weekly! < b.weekly! ? 1 : -1));
const featured = weeklies[0];
const featuredLines = featured
  ? takes
      .filter((p) => p.sceneId === featured.id)
      .map((p) => ({ name: identityOf(p, dialects, places).name, said: p.lines[0]?.textDialect ?? '' }))
  : [];

// 首页那句宣传语里的地名从数据推出来，不写死。
// 2026-09-05 的教训：原文写着「在德州、青岛、广州之间横着听过去」，而德州和青岛
// 早已不是节点、广州从来就不是——写死的例子会在数据变动时静静地变成假话，
// 而首页第一句话是全站最不该说假话的地方。
const showcase = [...new Set(takes.map((t) => identityOf(t, dialects, places).name))].slice(0, 3);

const cards = Array.from(scenes.values())
  .filter((scene) => !scene.weekly)
  .map((scene) => {
    const forScene = takes.filter((p) => p.sceneId === scene.id);
    return {
      scene,
      count: forScene.length,
      first: forScene[0] ? identityOf(forScene[0], dialects, places).id : undefined,
      names: forScene.map((p) => identityOf(p, dialects, places).name),
    };
  })
  // 没有任何演绎的场景没有可点进去的目的地——first 会是 undefined，
  // 卡片链接会拼出 /s/{id}/undefined/ 死链。同款 guard 见
  // s/[scene]/compare/[beat].astro 的 getStaticPaths()。
  .filter((c) => c.count > 0);
---
<Base title="各说各话">
  <header class="top">
    <div class="eyebrow">方言场景剧场</div>
    <h1>各说各话</h1>
    <p class="tagline">
      同一出戏，各地各演一遍。骨架统一，措辞自便——所以你能把「妈妈爆发」这一拍，
      在{showcase.join('、')}之间横着听过去。
    </p>
  </header>

  <nav class="ways">
    <a href="/guess/"><b>盲听猜方言</b><span>不给标签，猜是哪儿的</span></a>
    <a href="/map/"><b>方言地图</b><span>看看你那儿点亮了没有</span></a>
    <a href="/record/"><b>录一段</b><span>网页上直接录，不用注册</span></a>
    <a href="/swearing/"><b>脏话也是方言</b><span>立场说明 · 有投票</span></a>
  </nav>

  {featured && (
    <section class="weekly">
      <a class="wk" href="/weekly/">
        <div class="wk-eyebrow">一句话挑战 · {featured.weekly}</div>
        <h2 class="wk-title">{featured.title}</h2>
        <div class="wk-lines">
          {featuredLines.map(({ name, said }) => (
            <div class="wk-line"><span class="wk-name">{name}</span><span class="wk-said">{said}</span></div>
          ))}
        </div>
        <p class="wk-cta">你们那儿怎么说？录一句，十五秒 →</p>
      </a>
    </section>
  )}

  <section>
    <h2>挑一出戏</h2>
    <div class="grid">
      {cards.map(({ scene, count, first, names }) => (
        <a class="card" href={`/s/${scene.id}/${first}/`}>
          <h3>{scene.title}</h3>
          <p class="sit">{scene.situation}</p>
          <p class="meta">{count} 种说法 · {names.join(' / ')}</p>
        </a>
      ))}
    </div>
  </section>

  <footer>
    <p>
      台词由 AI 生成，未经母语者校对。这不是偷懒，是默认状态：
      先给一个粗糙的版本，再等老乡来纠正。<a href="/record/">来录一段 →</a>
    </p>
    <p class="second">
      吵架戏里的脏话是原样留着的——<a href="/swearing/">脏话也是方言，这里说明为什么，并有一场投票 →</a>
    </p>
  </footer>
</Base>

<style>
  .top { padding: 64px 0 24px; display: flex; flex-direction: column; gap: 14px; }
  .eyebrow { font-family: "Noto Sans SC", sans-serif; font-size: 12px; letter-spacing: .22em; color: var(--dust); }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(44px, 8vw, 76px); line-height: 1; color: var(--cut); letter-spacing: .04em; margin: 0; }
  .tagline { font-size: 17px; color: var(--ink-2); max-width: 34em; margin: 0; }
  /* 剪纸窗撤掉后这里原本的 64px 会留出一个明显的空洞——上面没东西了，不需要那么大的隔断 */
  section { padding-top: 32px; }
  .ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2px; margin-top: 34px; }
  .ways a {
    display: flex; flex-direction: column; gap: 4px; text-decoration: none;
    background: var(--night-2); border: 1px solid var(--rule); padding: 16px 18px;
    transition: border-color .2s, transform .2s;
  }
  .ways a:hover { border-color: var(--cut); transform: translateY(-2px); }
  .ways a:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .ways b { font-family: "Noto Sans SC", sans-serif; font-size: 14.5px; color: var(--cut); font-weight: 600; }
  .ways span { font-family: "Noto Sans SC", sans-serif; font-size: 12px; color: var(--dust); }
  .weekly { padding-top: 34px; }
  .wk {
    display: block; text-decoration: none;
    background: var(--night-2); border: 1px solid var(--rule); border-left: 3px solid var(--cut);
    padding: 24px 26px; transition: border-color .2s, transform .2s;
  }
  .wk:hover { border-color: var(--cut); transform: translateY(-2px); }
  .wk:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .wk-eyebrow { font-family: "Noto Sans SC", sans-serif; font-size: 11.5px; letter-spacing: .2em; color: var(--dust); }
  .wk-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(30px, 5vw, 44px); color: var(--cut); margin: 8px 0 16px; }
  .wk-lines { display: flex; flex-direction: column; gap: 6px; }
  .wk-line { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .wk-name { font-family: "Noto Sans SC", sans-serif; font-size: 11.5px; color: var(--dust); letter-spacing: .08em; min-width: 5.5em; }
  .wk-said { font-size: 17px; color: var(--ink-2); }
  .wk-cta { font-family: "Noto Sans SC", sans-serif; font-size: 13px; color: var(--cut-lit); margin: 18px 0 0; }
  h2 { font-family: var(--font-display); font-weight: 700; font-size: 28px; color: var(--cut); margin: 0 0 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2px; }
  .card {
    background: var(--night-2); border: 1px solid var(--rule); padding: 24px 22px;
    text-decoration: none; display: flex; flex-direction: column; gap: 8px;
    transition: border-color .2s, transform .2s;
  }
  .card:hover { border-color: var(--cut); transform: translateY(-2px); }
  .card:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .card h3 { font-family: var(--font-display); font-weight: 700; font-size: 24px; color: var(--cut); margin: 0; }
  .sit { font-size: 14.5px; color: var(--ink-2); margin: 0; }
  .meta { font-family: "Noto Sans SC", sans-serif; font-size: 12px; color: var(--dust); margin: 0; letter-spacing: .06em; }
  footer { margin-top: 80px; padding-top: 26px; border-top: 1px solid var(--rule); }
  footer p { font-size: 13.5px; color: var(--dust); margin: 0; }
  footer .second { margin-top: 8px; }
  footer a { color: var(--cut-lit); text-decoration: none; }
</style>
