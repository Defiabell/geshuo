---
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { loadSite } from '../lib/content';
import { identityOf } from '../lib/identity';
import { panFor } from '../lib/geo';
import { colorFor, rampStops } from '../lib/palette';
import { indentFor, segments } from '../lib/proof';
import { weeklySchedule } from '../lib/weekly';

// 首页不走 getStaticPaths，属于顶层 frontmatter 作用域，可以直接用
// process.cwd() 声明常量——理由同 [scene]/compare/[beat].astro 里的注释：
// 相对 new URL(...) + import.meta.url 的写法在 astro build 时会指向
// rolldown 打包产物自身的位置，路径深度算不对。
const DATA_DIR = join(process.cwd(), 'src', 'data');
const { scenes, takes, dialects, places } = loadSite(DATA_DIR);

// 一句话挑战不混进「挑一出戏」——它是低门槛入口，戏是深度内容，
// 摆在一起会让人以为一句话也要录五条。
//
// 排期判断在 src/lib/weekly.ts，首页与 /weekly/ 共用一处：两处各写一遍时
// 首页放上一期、CTA 点进去是下一期，当场对不上。
const featured = weeklySchedule(scenes.values()).current;

/**
 * 首页要出声。
 *
 * 在此之前首页有 0 个音频元素、0 个按钮——一个关于声音的网站，front door
 * 是哑的。整个价值主张是「同一句话在几个地方并排响」，而不点进去的人永远
 * 体验不到。这是漏斗第一格漏了，不是小瑕疵。
 *
 * 所以本周那一句直接搬到首屏，带播放键、带声像、带色条。三条轴全是同一份
 * 坐标算出来的（src/lib/proof.ts）：
 * - 上下顺序与颜色 ← 纬度（北在上、色偏冷）
 * - 缩进           ← 经度（西靠左、东靠右）
 * - 声像           ← 纬度（北在左耳、南在右耳）
 */
const featuredRows = featured
  ? takes
      .filter((p) => p.sceneId === featured.id)
      .map((p) => {
        const identity = identityOf(p, dialects, places);
        const line = p.lines[0];
        return {
          identity,
          said: line?.textDialect ?? '',
          audio: line?.audio,
          durationMs: line?.durationMs,
          pan: panFor(identity.lat),
          color: colorFor(identity),
          // 96px 而不是默认 48：四个地方只跨 104–125°E，48px 的差别看着
          // 像没对齐，不像阶梯。窄屏会在 CSS 里整体归零。
          indent: indentFor(identity.lng, 96),
          human: p.source === 'human',
        };
      })
      .sort((a, b) => (b.identity.lat ?? -90) - (a.identity.lat ?? -90))
  : [];
const featuredPlayable = featuredRows.filter((l) => l.audio).length;
// 色条：按真实时长切分，兼任播放进度条。缺时长就整条不画（见 proof.ts）
const bar = segments(featuredRows);

/**
 * 报头：一字一色，取色阶的四档（palette.ts 的 rampStops）。
 *
 * 它不挂在任何具体地方上，它是**这个站的图例**——从北到南。所以四个字
 * 读下来就是下面色条、地图、声像共用的那条轴。
 *
 * 试过让它印成套色错位的重影（同四个字印四遍、按经纬度错开），失败了，
 * 原因记在 src/lib/proof.ts 顶部：这条南北渐变的调色板天生邻近、天生偏深，
 * 叠印只会糊成一团黑加一道彩色投影。
 */
const WORDMARK = [...'各说各话'];
const wordInks = rampStops(WORDMARK.length);
// 「几地在录」是数据推出来的：报头旁边这行小字会自己跟着这个项目长大
const placeCount = new Set(
  takes.map((t) => identityOf(t, dialects, places)).map((d) => d.id),
).size;

// 首页那句宣传语里的地名从数据推出来，不写死。
// 2026-09-05 的教训：原文写着「在德州、青岛、广州之间横着听过去」，而德州和青岛
// 早已不是节点、广州从来就不是——写死的例子会在数据变动时静静地变成假话，
// 而首页第一句话是全站最不该说假话的地方。
const showcase = [...new Set(takes.map((t) => identityOf(t, dialects, places).name))].slice(0, 3);

const cards = Array.from(scenes.values())
  .filter((scene) => !scene.weekly)
  .map((scene) => {
    const forScene = takes.filter((p) => p.sceneId === scene.id);
    const ids = forScene.map((p) => identityOf(p, dialects, places));
    return {
      scene,
      // 按纬度排，和全站一致：一排墨点从冷到暖，就是一条从北到南的路线
      ids: ids.slice().sort((a, b) => (b.lat ?? -90) - (a.lat ?? -90)),
      beats: scene.beats.length,
      first: ids[0]?.id,
    };
  })
  // 没有任何演绎的场景没有可点进去的目的地——first 会是 undefined，
  // 卡片链接会拼出 /s/{id}/undefined/ 死链。同款 guard 见
  // s/[scene]/compare/[beat].astro 的 getStaticPaths()。
  .filter((c) => c.ids.length > 0);
---
<Base title="各说各话">
  {/* 报头 = 图例。四个字，一字一色，从北到南——底下的色条读的是同一条轴 */}
  <header class="top">
    <div class="slug">
      <span>方言场景剧场</span>
      <span class="ink-count">{placeCount} 地在录</span>
    </div>

    <h1 class="mast">
      {WORDMARK.map((ch, i) => <i style={`--c:${wordInks[i]}`}>{ch}</i>)}
    </h1>

    <p class="tagline">
      同一出戏，各地各演一遍。骨架统一，措辞自便——所以你能把「妈妈爆发」这一拍，
      在{showcase.join('、')}之间横着听过去。
    </p>
  </header>

  {featured && (
    <section class="proof">
      <div class="slug">
        <span>一句话挑战 · {featured.weekly}</span>
        <span class="legend">色序＝纬度　缩进＝经度</span>
      </div>
      <h2 class="wk-title">{featured.title}</h2>
      <p class="wk-sit">{featured.situation}</p>

      {/*
        色条：印刷样张边上那排色块。宽度是真实时长，同时兼任播放进度条，
        点一段就跳过去听那一段（见 src/scripts/chain.ts）。
        连听键长在色条头上，整条读起来是一件乐器，不是一个按钮加一张图。
      */}
      {featuredPlayable > 1 && (
        <div class="rig">
          <button class="btn-chain" id="chain" data-idle={`▶ ${featuredPlayable} 地连听`}>
            ▶ {featuredPlayable} 地连听
          </button>
          {bar.length > 0 ? (
            <div class="colorbar">
              {bar.map((s) => (
                <button
                  class="seg"
                  type="button"
                  data-seg={s.key}
                  style={`flex:${s.ms};--c:${s.color}`}
                  aria-label={`播放${s.name}，${s.label} 秒`}
                >
                  <b>{s.name}</b><em>{s.label}s</em>
                </button>
              ))}
            </div>
          ) : (
            <span class="wk-hint">从北到南连着放完。戴耳机——声音会从左边走到右边。</span>
          )}
        </div>
      )}

      {/*
        阶梯：从上到下是北到南，从左到右是西到东。一块文字就是一张地图。
        行首那个小方块是墨点，也是播放键——这个站的按钮是一块油墨，不是圆圈。
      */}
      <div class="stack">
        {featuredRows.map(({ identity, said, audio, pan, color, indent, human }) => (
          <div
            class={`col line ${human ? 'real' : 'ai'}`}
            data-audio={audio ?? ''}
            data-key={identity.id}
            data-pan={pan}
            style={`--c:${color};--x:${indent}px`}
          >
            {audio
              ? <button class="one" type="button" aria-label={`播放${identity.name}`}></button>
              : <span class="one blank" aria-hidden="true"></span>}
            <span class="who">{identity.name}</span>
            <span class={human ? 'said grain-real' : 'said grain-ai'}>{said}</span>
          </div>
        ))}
      </div>

      <p class="wk-cta"><a href="/weekly/">你们那儿怎么说？写一句或录一句 →</a></p>
    </section>
  )}

  <nav class="ways">
    <a href="/guess/"><b>盲听猜方言</b><span>不给标签，猜是哪儿的</span></a>
    <a href="/map/"><b>方言地图</b><span>看看你那儿点亮了没有</span></a>
    <a href="/record/"><b>录一段</b><span>网页上直接录，不用注册</span></a>
    <a href="/swearing/"><b>脏话也是方言</b><span>立场说明 · 有投票</span></a>
  </nav>

  <section class="plays">
    <h2 class="slug"><span>挑一出戏</span><span class="legend">一个墨点＝一个地方</span></h2>
    {cards.map(({ scene, ids, beats, first }) => (
      <a class="play" href={`/s/${scene.id}/${first}/`}>
        <h3>{scene.title}</h3>
        <p class="sit">{scene.situation}</p>
        <p class="meta">
          <span class="dots">
            {ids.map((d) => (
              <i style={`--c:${colorFor(d, 0.5)}`} title={d.name}></i>
            ))}
          </span>
          <span class="names">{ids.map((d) => d.name).join(' / ')}</span>
          <span class="beats">{beats} 拍</span>
        </p>
      </a>
    ))}
  </section>

  <footer>
    <p>
      台词由 AI 生成，未经母语者校对。这不是偷懒，是默认状态：
      先给一个粗糙的版本，再等老乡来纠正。<a href="/record/">来录一段 →</a>
    </p>
    <p class="second">
      吵架戏里的脏话是原样留着的——<a href="/swearing/">脏话也是方言，这里说明为什么，并有一场投票 →</a>
    </p>
  </footer>
</Base>

<script>
  import { initChain } from '../scripts/chain';
  const proof = document.querySelector<HTMLElement>('.proof');
  if (proof) initChain(proof);
</script>

<style>
  /* ── 印工的批注：所有 mono 小字 ────────────────────────── */
  .slug {
    display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .16em;
    color: var(--dust); text-transform: uppercase;
  }
  /* 批注要弱，但不能弱到看不见——第一版用 --rule，在纸白上直接消失了 */
  .slug .legend, .slug .ink-count { color: var(--dust); opacity: .72; letter-spacing: .1em; }

  /* ── 报头 ─────────────────────────────────────────────── */
  .top { padding: 60px 0 26px; display: flex; flex-direction: column; gap: 16px; }
  .mast {
    margin: 0 0 6px; font-family: var(--font-display);
    font-weight: 900; font-size: clamp(46px, 8.4vw, 82px); line-height: 1;
    letter-spacing: .01em;
  }
  /* 前景油墨一律走 --ink-c（深色主题会提亮，见 tokens.css 的 --ink-lift） */
  .mast i { font-style: normal; color: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift)); }
  .tagline { font-size: 17px; color: var(--ink-2); max-width: 34em; margin: 0; }

  /* ── 本周一句话 ───────────────────────────────────────── */
  .proof { margin: 26px 0 0; display: flex; flex-direction: column; gap: 0; }
  .wk-title {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(30px, 4.6vw, 42px); color: var(--cut);
    margin: 14px 0 6px; letter-spacing: .02em;
  }
  .wk-sit { font-family: var(--font-ui); font-size: 13.5px; color: var(--ink-2); margin: 0 0 20px; max-width: 34em; }

  /* 连听键长在色条头上：一件乐器 */
  .rig { display: flex; align-items: stretch; gap: 2px; margin-bottom: 26px; flex-wrap: wrap; }
  .btn-chain {
    font-family: var(--font-ui); font-size: 13.5px; cursor: pointer; white-space: nowrap;
    background: var(--cut); color: var(--paper); border: none;
    padding: 0 22px; height: 40px; transition: background .18s;
  }
  .btn-chain:hover { background: var(--cut-lit); }
  .btn-chain:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }
  .colorbar { display: flex; gap: 2px; flex: 1 1 420px; min-width: 260px; }
  /*
   * 淡色调一律 color-mix(in oklab)，不用 in srgb：等比例的 sRGB 混色出来
   * 轻重不一——赭色 30% 兑纸白读着比板岩蓝 30% 淡得多，色条最右一段因此
   * 总像没上墨。感知空间里混才是等量。
   */
  .seg {
    --ink-c: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift));
    position: relative; overflow: hidden; cursor: pointer; min-width: 0;
    height: 40px; border: none; border-top: 3px solid var(--ink-c); padding: 0 0 0 9px;
    background: color-mix(in oklab, var(--c) 30%, var(--night));
    display: flex; align-items: center; gap: 7px; text-align: left;
    transition: background .18s;
  }
  .seg:hover { background: color-mix(in oklab, var(--c) 42%, var(--night)); }
  .seg:focus-visible { outline: 2px solid var(--live); outline-offset: -2px; }
  .seg b, .seg em {
    position: relative; z-index: 1; font-family: var(--font-mono); font-style: normal;
    font-weight: 500; font-size: 10.5px; letter-spacing: .04em; color: var(--ink-c); white-space: nowrap;
  }
  .seg em { opacity: .72; font-variant-numeric: tabular-nums; }
  /* 进度：--p 由 chain.ts 按 timeupdate 写入 */
  .seg::after {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0;
    width: calc(var(--p, 0) * 1%); background: color-mix(in oklab, var(--c) 42%, transparent);
  }
  .seg.on { background: color-mix(in oklab, var(--c) 48%, var(--night)); }
  .seg.on b { color: var(--ink); }
  .wk-hint { font-family: var(--font-ui); font-size: 12.5px; color: var(--dust); align-self: center; }

  /* ── 阶梯 ─────────────────────────────────────────────── */
  .stack { display: flex; flex-direction: column; }
  .line {
    --ink-c: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift));
    display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
    padding: 5px 0 5px var(--x, 0); transition: background .2s;
  }
  /* 窄屏上阶梯要让位：横向空间比这个隐喻重要 */
  @media (max-width: 680px) { .line { padding-left: 0; } }
  .line.on { background: var(--paper); box-shadow: inset 2px 0 0 var(--live); }
  /* 墨点即播放键 */
  .one {
    width: 13px; height: 13px; flex: 0 0 13px; padding: 0; cursor: pointer;
    background: var(--ink-c, var(--ink-2)); border: none; border-radius: 0;
    transition: transform .16s, opacity .16s; align-self: center;
  }
  .one:hover { transform: scale(1.25); }
  .one:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }
  .one.blank { background: transparent; border: 1px solid var(--rule); cursor: default; }
  .ai .one { opacity: .78; }
  .who {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .06em;
    color: var(--ink-c, var(--dust)); min-width: 7em;
  }
  .real .who { font-weight: 500; }
  .said { font-family: var(--font-display); font-size: 20px; color: var(--ink); flex: 1 1 16em; }
  .ai .said { color: var(--ink-2); }
  .wk-cta { font-family: var(--font-ui); font-size: 13px; margin: 22px 0 0; }
  .wk-cta a { color: var(--cut-lit); text-decoration: none; }
  .wk-cta a:hover { text-decoration: underline; }

  /* ── 四个入口：去掉方框，改成四条墨条 ──────────────────── */
  .ways { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 22px; margin: 46px 0 0; }
  .ways a {
    display: flex; flex-direction: column; gap: 3px; text-decoration: none;
    border-top: 2px solid var(--rule); padding: 11px 0 0; transition: border-color .2s;
  }
  .ways a:hover { border-top-color: var(--cut); }
  .ways a:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 3px; }
  .ways b { font-family: var(--font-display); font-size: 17px; color: var(--cut); font-weight: 700; }
  .ways span { font-family: var(--font-ui); font-size: 12px; color: var(--dust); }

  /* ── 挑一出戏：条目，不是卡片 ──────────────────────────── */
  .plays { margin-top: 64px; }
  .play {
    display: block; text-decoration: none; padding: 20px 0 18px;
    border-top: 1px solid var(--rule); transition: background .2s;
  }
  /* h2 降级成印工批注：视觉上让位给戏名，语义上仍是这一节的标题 */
  .plays .slug { padding-bottom: 10px; margin: 0; font-weight: 400; }
  .play:first-of-type { border-top-width: 2px; border-top-color: var(--ink-2); }
  .play:hover { background: var(--night-2); }
  .play:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .play h3 {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 3.2vw, 31px);
    color: var(--cut); margin: 0 0 4px; letter-spacing: .02em;
  }
  .play .sit { font-family: var(--font-ui); font-size: 13.5px; color: var(--ink-2); margin: 0 0 12px; max-width: 42em; }
  .play .meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 0; }
  .dots { display: flex; gap: 3px; }
  .dots i { width: 11px; height: 11px; display: block;
    background: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift)); }
  .names, .beats { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: .06em; color: var(--dust); }
  .beats { opacity: .6; }

  footer { margin-top: 80px; padding-top: 26px; border-top: 1px solid var(--rule); }
  footer p { font-family: var(--font-ui); font-size: 13px; color: var(--dust); margin: 0; }
  footer .second { margin-top: 8px; }
  footer a { color: var(--cut-lit); text-decoration: none; }
</style>
