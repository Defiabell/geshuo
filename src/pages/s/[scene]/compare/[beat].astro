---
import { join } from 'node:path';
import Base from '../../../../layouts/Base.astro';
import { levelLabel } from '../../../../lib/dialect-tree';
import { loadSite, takesForBeat } from '../../../../lib/content';
import { identityOf } from '../../../../lib/identity';
import { panFor } from '../../../../lib/geo';
import { chainSeconds } from '../../../../lib/audio';
import { segments } from '../../../../lib/proof';
import { colorFor } from '../../../../lib/palette';
import { VERIFICATION_LABELS, VERIFICATION_TAG_CLASS } from '../../../../lib/verification';
import { AGE_LABELS } from '../../../../lib/types';

export async function getStaticPaths() {
  // getStaticPaths() runs in its own isolated scope at build time — only
  // imports are shared from the frontmatter, not locally computed consts —
  // so DATA_DIR must be computed here rather than at the top of the module.
  //
  // A relative `new URL('../../../../data/', import.meta.url)` breaks under
  // `astro build`: rolldown emits this function into a chunk under
  // dist/.prerender/chunks/, and import.meta.url there resolves to that
  // chunk's own location, not this source file's — so the relative offset
  // lands at the wrong depth against the *build output*, not src/. Anchoring
  // on process.cwd() (the project root pnpm/astro is invoked from, in both
  // dev and build) is stable across both.
  const DATA_DIR = join(process.cwd(), 'src', 'data');
  const { scenes, takes, dialects, places } = loadSite(DATA_DIR);
  const paths = [];

  for (const scene of scenes.values()) {
    const forScene = takes.filter((p) => p.sceneId === scene.id);
    // 没有任何演绎的场景没有可对比的内容——跳过，否则会生成空页面
    // 且 columns[0]?.dialect.id ?? '' 会拼出 /s/xxx// 这样的畸形死链。
    if (forScene.length === 0) continue;
    for (const beat of scene.beats) {
      paths.push({
        params: { scene: scene.id, beat: beat.id },
        props: {
          scene,
          beat,
          // 按纬度从北到南排。配色也是按纬度给的（src/lib/palette.ts），
          // 两者一致时整排列头读起来就是一条从青到赭的色带，而不是四块随机颜色。
          columns: takesForBeat(forScene, scene.id, beat.id)
            .map(({ take, line }) => ({
              dialect: identityOf(take, dialects, places),
              take,
              line,
            }))
            .sort((a, b) => (b.dialect.lat ?? -90) - (a.dialect.lat ?? -90)),
        },
      });
    }
  }
  return paths;
}

const { scene, beat, columns } = Astro.props;
const sorted = scene.beats.slice().sort((a, b) => a.order - b.order);

// 对比页可能同时展示多个不同层级、不同来源（TTS / 真人）的方言列——粒度声明
// 不能只挂在场景页（GrainNotice 只在 [dialect].astro 里出现）。对比页本身是
// 可以直接分享、直接落地的 URL，spec 要求"页面上标注"而不是"某个页面上标注"。
const ttsColumns = columns.filter((c) => c.take.source === 'tts');
const hasTts = ttsColumns.length > 0;
const allTts = hasTts && ttsColumns.length === columns.length;
// 层级名从实际在场的 TTS 列推导，不写死"区/片"——粤语挂在大区级，
// 硬编码会当场说错话。
const ttsLevels = [...new Set(ttsColumns.map((c) => levelLabel(c.dialect.level)))];
const levelPhrase = ttsLevels.join('/') + '层级';
// 连听按钮只在真有两列以上带音频时出现——只有一条能放的时候，「连听」
// 这个词是骗人的。预估时长按每条 4 秒粗算，只为了让人知道点下去要花多久。
const playableCount = columns.filter((c) => c.line.audio).length;
// 真实时长，量不到就不显示——不按字数估，那会差三倍
const totalSeconds = chainSeconds(columns.map((c) => c.line));
const grainHeadline = allTts
  ? `以下均为 AI 合成语音，标注的是方言${levelPhrase}，不代表任何具体县市。`
  : `除真人录音列外，以下 AI 合成语音标注的是方言${levelPhrase}，不代表任何具体县市。`;

/**
 * 色条：按真实时长切分，兼任这个播放器的进度条与选段器（见 src/lib/proof.ts）。
 *
 * 它比「共 43 秒」有用得多——一眼能看出粤语最短、武城最长，而那本身就是
 * 方言差异的一部分。缺任何一条时长就整条不画，宽度不能是估的。
 */
const bar = segments(
  columns.map((c) => ({ identity: c.dialect, audio: c.line.audio, durationMs: c.line.durationMs })),
);

// 用词完全相同的列只展示一次台词。
// 真人录音确认「AI 那句就是我说的」时（accept 里的「同ai」），两列会一字不差，
// 并排放着像 bug。但这件事本身是有信息量的——它说明那份 AI 台词被本地人认了，
// 所以不是隐藏，是明说。
const enriched = columns.map((c, i) => {
  const same = columns.findIndex((x) => x.line.textDialect === c.line.textDialect);
  return { ...c, sameAs: same < i ? columns[same].dialect.name : null };
});
---
<Base title={`${scene.title} · 第 ${beat.order} 拍横着听 — 各说各话`}>
  <header class="top">
    <a class="home" href={`/s/${scene.id}/${columns[0]?.dialect.id ?? ''}/`}>← 回到场景</a>
    <h1>{beat.intent}</h1>
    <p class="situation">{scene.title} · 第 {beat.order} 拍 —— 同一拍，各地并排。</p>
  </header>

  <nav class="beats">
    {sorted.map((b) => (
      <a href={`/s/${scene.id}/compare/${b.id}/`} aria-current={b.id === beat.id ? 'page' : undefined}>
        {String(b.order).padStart(2, '0')}
      </a>
    ))}
  </nav>

  {columns.some((c) => c.take.source === 'human' && c.take.transcript === 'approximate') && (
    <div class="grain loose">
      <p>
        <strong>真人录音那几列以音为准：字是大意，不是逐字转写。</strong>
        很多方言词没有通行写法，只能拿同音字凑。
      </p>
    </div>
  )}

  {hasTts && (
    <div class="grain">
      <p>
        <strong>{grainHeadline}</strong>
        模型给不出县域口音，只能给一个笼统的腔调。
      </p>
      <a class="cta" href={`/record/${scene.id}/`}>你是本地人？录一个真的</a>
    </div>
  )}

  {playableCount > 1 && (
    <>
      {/* 连听键长在色条头上，整条读起来是一件乐器，不是一个按钮加一张图 */}
      <div class="rig">
        <button class="btn-chain" id="chain" data-idle={`▶ ${playableCount} 地连听`}>▶ {playableCount} 地连听</button>
        {bar.length > 0 ? (
          <div class="colorbar">
            {bar.map((sg) => (
              <button
                class="seg"
                type="button"
                data-seg={sg.key}
                style={`flex:${sg.ms};--c:${sg.color}`}
                aria-label={`播放${sg.name}，${sg.label} 秒`}
              ><b>{sg.name}</b><em>{sg.label}s</em></button>
            ))}
          </div>
        ) : (
          <span class="bar-hint">从北到南连着放完。戴耳机，声音会从左边走到右边。</span>
        )}
      </div>
      <div class="bar-foot">
        <span class="bar-hint">
          点色条上任意一段可以只听那一段{totalSeconds !== null && `　·　整条 ${totalSeconds} 秒`}
        </span>
        <button class="btn-save" id="save-card" type="button">存成图片</button>
      </div>
    </>
  )}

  <div class="compare" id="compare">
    {enriched.map(({ dialect, take, line, sameAs }) => {
      const human = take.source === 'human';
      return (
        <div class={`col ${human ? 'real' : 'ai'}`} data-key={dialect.id} data-pan={panFor(dialect.lat)} data-audio={line.audio ?? ''} style={`--c:${colorFor(dialect)}`}>
          <h2>
            <span class="nm">{dialect.name}</span>
            <span class="lv2">
              {levelLabel(dialect.level)} · {human ? '真人' : 'AI'}{take.age && ` · ${AGE_LABELS[take.age]}`}
            </span>
            {line.audio && <button class="one" type="button" aria-label={`只听${dialect.name}`}></button>}
          </h2>
          <p class={`said ${human ? 'grain-real' : 'grain-ai'}`}>{line.textDialect}</p>
          {sameAs && <p class="same">用词与{sameAs}一字不差——这一句是本地人认下来的，差别在发音里</p>}
          <p class="trans">{line.textMandarin}</p>
          {line.note && <p class="gloss">{line.note}</p>}
          <span class={`tag ${VERIFICATION_TAG_CLASS[take.verification]}`}>
            {VERIFICATION_LABELS[take.verification]}
          </span>
        </div>
      );
    })}
  </div>
</Base>

<script>
  import { initChain } from '../../../../scripts/chain';
  import { initCard } from '../../../../scripts/card';
  const el = document.getElementById('compare');
  const root = el?.parentElement ?? document.body;
  if (el) initChain(root);
  // 可分享的单位是「一句」不是「一场」——没有人会转发一场戏
  initCard(root);
</script>

<style>
  .top { padding: 56px 0 8px; }
  .home { font-family: var(--font-ui); font-size: 12px; color: var(--dust); text-decoration: none; letter-spacing: .14em; }
  .home:hover { color: var(--cut-lit); }
  h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(28px, 4.4vw, 40px); color: var(--ink); margin: 16px 0 6px; letter-spacing: .02em; }
  .situation { margin: 0 0 26px; font-size: 14px; color: var(--ink-2); }

  .beats { display: flex; gap: 6px; margin-bottom: 20px; }
  .beats a {
    font-family: var(--font-ui); font-size: 12px; letter-spacing: .1em;
    padding: 6px 12px; border: 1px solid var(--rule); color: var(--dust);
    text-decoration: none; border-radius: 1px;
  }
  .beats a:hover { border-color: var(--ink-2); color: var(--ink); }
  .beats a:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }
  .beats a[aria-current="page"] { background: var(--ink); border-color: var(--ink); color: var(--night); }

  /* 免责声明降级：它是免责声明，不该比台词还抢眼 */
  .grain {
    display: flex; gap: 16px; align-items: baseline; justify-content: space-between;
    border-top: 1px solid var(--rule); padding: 11px 0 0; margin: 0 0 18px;
  }
  .grain p { margin: 0; font-family: var(--font-ui); font-size: 12px; color: var(--dust); line-height: 1.7; }
  .grain strong { color: var(--ink-2); font-weight: 500; }
  .grain.loose { border-top-style: dashed; }
  .cta {
    font-family: var(--font-ui); font-size: 12.5px; white-space: nowrap; text-decoration: none;
    color: var(--cut-lit); border-bottom: 1px solid var(--rule); padding-bottom: 2px;
  }
  .cta:hover { border-bottom-color: var(--cut-lit); }
  .cta:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }

  /* 连听键 + 色条 = 一件乐器 */
  .rig { display: flex; align-items: stretch; gap: 2px; margin: 22px 0 0; flex-wrap: wrap; }
  .btn-chain {
    font-family: var(--font-ui); font-size: 14px; cursor: pointer; white-space: nowrap;
    background: var(--ink); color: var(--night); border: none;
    padding: 0 24px; height: 42px; transition: background .2s;
  }
  .btn-chain:hover { background: var(--live); }
  .btn-chain:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }
  .colorbar { display: flex; gap: 2px; flex: 1 1 420px; min-width: 260px; }
  /* 淡色调一律在 oklab 里混：sRGB 等比例混色出来轻重不一，赭色那段会发白 */
  .seg {
    --ink-c: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift));
    position: relative; overflow: hidden; cursor: pointer; min-width: 0;
    height: 42px; border: none; border-top: 3px solid var(--ink-c); padding: 0 0 0 9px;
    background: color-mix(in oklab, var(--c) 30%, var(--night));
    display: flex; align-items: center; gap: 7px; text-align: left; transition: background .18s;
  }
  .seg:hover { background: color-mix(in oklab, var(--c) 42%, var(--night)); }
  .seg:focus-visible { outline: 2px solid var(--live); outline-offset: -2px; }
  .seg b, .seg em {
    position: relative; z-index: 1; font-family: var(--font-mono); font-style: normal;
    font-weight: 500; font-size: 10.5px; letter-spacing: .04em; color: var(--ink-c); white-space: nowrap;
  }
  .seg em { opacity: .72; font-variant-numeric: tabular-nums; }
  /* 窄屏上段内放不下两个标签就先舍秒数——宽度已经把长短说清楚了 */
  @media (max-width: 560px) { .seg em { display: none; } }
  /* 进度：--p 由 chain.ts 按 timeupdate 写入 */
  .seg::after {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0;
    width: calc(var(--p, 0) * 1%); background: color-mix(in oklab, var(--c) 42%, transparent);
  }
  .seg.on { background: color-mix(in oklab, var(--c) 48%, var(--night)); }
  .seg.on b { color: var(--ink); }
  .bar-foot { display: flex; align-items: baseline; gap: 16px; margin: 10px 0 26px; flex-wrap: wrap; }
  .btn-save { font-family: var(--font-ui); font-size: 13px; cursor: pointer;
    border: 1px solid var(--rule); background: transparent; color: var(--ink-2);
    padding: 8px 15px; border-radius: 2px; margin-left: auto; transition: border-color .18s, color .18s; }
  .btn-save:hover { border-color: var(--cut); color: var(--cut); }
  .btn-save:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
  .btn-save[disabled] { opacity: .5; cursor: default; }
  .bar-hint { font-family: var(--font-ui); font-size: 12.5px; color: var(--dust); }

  .compare { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 30px; }
  .col {
    --c: var(--ink-2);
    /* 前景油墨：深色主题下提亮，否则真人那列（最该显眼的）会最暗 */
    --ink-c: color-mix(in oklab, var(--c), var(--ink) var(--ink-lift));
    display: flex; flex-direction: column;
  }
  .col h2 {
    font-family: var(--font-ui); font-size: 12px; margin: 0 0 15px; letter-spacing: .1em;
    color: var(--ink-c); font-weight: 500; padding-bottom: 8px;
    border-bottom: 2px solid var(--ink-c); display: flex; align-items: baseline; gap: 8px;
  }
  .col.ai h2 { border-bottom-style: dashed; opacity: .82; }
  .col.real h2 { border-bottom-width: 3px; }
  .nm { flex: 1; }
  .lv2 { font-size: 10.5px; color: var(--dust); letter-spacing: .08em; }
  /* 播放键是一块油墨，不是圆圈——全站统一（见 src/lib/proof.ts） */
  .one {
    cursor: pointer; padding: 0; background: var(--ink-c); border: none; border-radius: 0;
    width: 13px; height: 13px; flex: none; align-self: center;
    transition: transform .16s;
  }
  .one:hover { transform: scale(1.25); }
  .col.ai .one { opacity: .78; }
  .one:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }

  /* 虚实语法：AI 的字发虚偏灰，真人的字锐利色实 */
  .said {
    font-family: var(--font-display); font-size: clamp(18px, 2.1vw, 22px);
    line-height: 1.62; margin: 0 0 12px; letter-spacing: .01em; color: var(--ink-c);
  }
  .col.ai .said { color: color-mix(in oklab, var(--ink-c) 60%, var(--dust)); }
  .same {
    font-family: var(--font-ui); font-size: 11.5px; color: var(--dust);
    margin: -4px 0 12px; padding-left: 10px; border-left: 2px solid var(--rule); line-height: 1.7;
  }
  /*
   * 普通话对照用官方体（Noto Sans SC），方言原话用宋体。
   * 这不是排版口味，是这个站的立场：**标准语是表格和路牌上的字，
   * 方言是人说话的字**。同一段意思在两种字体里，差别自己会说话。
   */
  .trans {
    font-family: var(--font-ui); font-size: 13px; color: var(--ink-2);
    margin: 0 0 12px; line-height: 1.8;
  }
  /* 注释升格：这是这个站独有的价值，给它悬挂缩进，不再压成灰色小字 */
  .gloss {
    font-family: var(--font-ui); font-size: 12.5px; color: var(--ink-2); margin: 0;
    padding-left: 14px; text-indent: -14px; line-height: 1.85;
  }
  .tag {
    font-family: var(--font-ui); font-size: 10.5px; letter-spacing: .09em;
    margin-top: 16px; color: var(--dust); align-self: flex-start;
  }
  .tag.human { color: var(--ink-c); font-weight: 500; }

  /* 连听时当前列亮起来——四条连着放完，得知道刚才那句是哪儿的 */
  .col.on .said { color: var(--ink-c); opacity: 1; text-shadow: none; }
  .col.on h2 { opacity: 1; border-bottom-color: var(--live); }
  .col.on .lv2 { color: var(--live); }
</style>
