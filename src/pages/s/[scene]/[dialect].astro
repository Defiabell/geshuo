---
import { join } from 'node:path';
import Base from '../../../layouts/Base.astro';
import DialectChips from '../../../components/DialectChips.astro';
import GrainNotice from '../../../components/GrainNotice.astro';
import LineCard from '../../../components/LineCard.astro';
import { loadDialects } from '../../../lib/dialect-tree';
import { loadScenes, loadPerformances, validateContent } from '../../../lib/content';

export async function getStaticPaths() {
  // getStaticPaths() runs in its own isolated scope at build time — only
  // imports are shared from the frontmatter, not locally computed consts —
  // so DATA_DIR must be computed here rather than at the top of the module.
  //
  // A relative `new URL('../../../data/', import.meta.url)` breaks under
  // `astro build`: rolldown emits this function into a chunk under
  // dist/.prerender/chunks/, and import.meta.url there resolves to that
  // chunk's own location, not this source file's — so the relative offset
  // lands three levels up from the *build output*, i.e. the project root,
  // not src/. Anchoring on process.cwd() (the project root pnpm/astro is
  // invoked from, in both dev and build) is stable across both.
  const DATA_DIR = join(process.cwd(), 'src', 'data');
  const dialects = loadDialects(DATA_DIR);
  const scenes = loadScenes(DATA_DIR);
  const performances = loadPerformances(DATA_DIR);
  validateContent(scenes, performances, dialects);

  return performances.map((p) => ({
    params: { scene: p.sceneId, dialect: p.dialectId },
    props: {
      scene: scenes.get(p.sceneId)!,
      performance: p,
      dialect: dialects.get(p.dialectId)!,
      siblings: performances
        .filter((x) => x.sceneId === p.sceneId)
        .map((x) => dialects.get(x.dialectId)!),
      allForScene: performances.filter((x) => x.sceneId === p.sceneId),
    },
  }));
}

const { scene, performance, dialect, siblings, allForScene } = Astro.props;
const lineOf = (beatId: string) => performance.lines.find((l) => l.beatId === beatId)!;
---
<Base title={`${scene.title} · ${dialect.name} — 各说各话`} description={scene.situation}>
  <header class="top">
    <a class="home" href="/">← 各说各话</a>
    <h1>{scene.title}</h1>
    <p class="situation">{scene.situation}</p>
  </header>

  <DialectChips
    dialects={siblings}
    performances={allForScene}
    sceneId={scene.id}
    currentId={dialect.id}
  />
  <GrainNotice dialect={dialect} source={performance.source} transcript={performance.transcript} />

  <div class="bar">
    <button class="btn-play" id="playAll">▶ 从头演一遍</button>
    <a class="cmp" href={`/s/${scene.id}/compare/${scene.beats[0].id}/`}>横着听第一拍 →</a>
  </div>

  <div id="lines">
    {scene.beats
      .slice()
      .sort((a, b) => a.order - b.order)
      .map((beat) => (
        <LineCard beat={beat} line={lineOf(beat.id)} verification={performance.verification} />
      ))}
  </div>
</Base>

<script>
  import { initPlayer } from '../../../scripts/player';
  initPlayer(document.body);
</script>

<style>
  .top { padding: 56px 0 22px; }
  .home {
    font-family: "Noto Sans SC", sans-serif; font-size: 13px;
    color: var(--dust); text-decoration: none; letter-spacing: .1em;
  }
  .home:hover { color: var(--cut-lit); }
  h1 {
    font-family: "ZCOOL QingKe HuangYou", serif; font-size: clamp(34px, 6vw, 54px);
    color: var(--cut); margin: 14px 0 8px; letter-spacing: .04em; line-height: 1.1;
  }
  .situation { margin: 0; font-size: 16px; color: var(--ink-2); max-width: 36em; }
  .bar { display: flex; gap: 16px; align-items: center; margin: 26px 0 10px; flex-wrap: wrap; }
  .btn-play {
    font-family: "Noto Sans SC", sans-serif; font-size: 14px;
    background: var(--cut); color: #FFF6E8; border: none;
    padding: 12px 22px; border-radius: 2px; cursor: pointer; transition: background .2s;
  }
  .btn-play:hover { background: var(--cut-lit); }
  .btn-play:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 3px; }
  .cmp { font-family: "Noto Sans SC", sans-serif; font-size: 14px; color: var(--ink-2); text-decoration: none; border-bottom: 1px solid var(--rule); }
  .cmp:hover { color: var(--cut-lit); border-bottom-color: var(--cut-lit); }
  .cmp:focus-visible { outline: 2px solid var(--cut-lit); outline-offset: 2px; }
</style>
