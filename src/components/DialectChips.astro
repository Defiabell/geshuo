---
import { levelLabel } from '../lib/dialect-tree';
import { colorFor } from '../lib/palette';
import type { Dialect, Take } from '../lib/types';
interface Props { dialects: Dialect[]; takes: Take[]; sceneId: string; currentId: string }
const { dialects, takes, sceneId, currentId } = Astro.props;
const sourceOf = (id: string) => takes.find((p) => p.dialectId === id)?.source;
---
<div class="dialects" role="group" aria-label="选择方言">
  {dialects.map((d) => {
    const src = sourceOf(d.id);
    const tail = src === 'human' ? '真人录音' : src === 'tts' ? 'AI 合成' : '待录';
    return (
      <a
        class={`chip ${src === 'human' ? 'real' : 'ai'}`}
        href={`/s/${sceneId}/${d.id}/`}
        style={`--c:${colorFor(d)}`}
        aria-current={d.id === currentId ? 'page' : undefined}
      >
        {d.name}<span class="lv">{levelLabel(d.level)} · {tail}</span>
      </a>
    );
  })}
</div>

<style>
  .dialects { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
  .chip {
    --c: var(--ink-2);
    font-family: var(--font-ui); font-size: 13.5px; text-decoration: none;
    background: none; border: none; border-top: 2px solid var(--c); color: var(--ink-2);
    padding: 8px 14px 8px 0; display: flex; align-items: baseline; gap: 8px;
    transition: color .2s, border-color .2s;
  }
  /* 虚实语法也进切换条：AI 的挂虚线，真人的挂实线 */
  .chip.ai { border-top-style: dashed; }
  .chip.real { border-top-width: 3px; }
  .chip:hover { color: var(--c); }
  .chip:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }
  .chip .lv { font-size: 10.5px; letter-spacing: .1em; color: var(--dust); }
  .chip[aria-current="page"] { color: var(--c); font-weight: 500; }
  .chip[aria-current="page"] .lv { color: var(--c); opacity: .8; }
</style>
