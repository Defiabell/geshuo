---
const PETALS = 16;
const LEAVES = 8;
const petalRots = Array.from({ length: PETALS }, (_, i) => (360 / PETALS) * i);
const leafRots = Array.from({ length: LEAVES }, (_, i) => (360 / LEAVES) * i + 22.5);
---
<g transform="translate(200,110) scale(0.78)" fill="var(--cut)">
  {petalRots.map((r) => (
    <g transform={`rotate(${r})`}>
      <path d="M0,-16 C10,-46 12,-74 0,-104 C-12,-74 -10,-46 0,-16 Z" />
      <circle cx="0" cy="-62" r="5.4" fill="var(--paper)" />
      <path d="M0,-108 l7,-13 l-7,-6 l-7,6 Z" />
    </g>
  ))}
  {leafRots.map((r) => (
    <path transform={`rotate(${r})`} d="M0,-118 C13,-131 30,-129 34,-116 C24,-112 10,-114 0,-118 Z" />
  ))}
  <circle r="20" />
  <circle r="10.5" fill="var(--paper)" />
  <circle r="4.6" />
</g>
