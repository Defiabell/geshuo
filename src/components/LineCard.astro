---
import type { Beat, TakeLine, Verification } from '../lib/types';
import { VERIFICATION_LABELS, VERIFICATION_TAG_CLASS } from '../lib/verification';
interface Props { beat: Beat; line: TakeLine; verification: Verification; color?: string; human?: boolean }
const { beat, line, verification, color = 'var(--ink-2)', human = false } = Astro.props;
const order = String(beat.order).padStart(2, '0');
---
<div class={`line ${human ? 'real' : 'ai'}`} data-beat={beat.id} data-who={beat.speakerRole} data-audio={line.audio ?? ''} style={`--c:${color}`}>
  <div>
    <div class="beat">{order}<br />{beat.intent}</div>
    {line.audio ? (
      <button class="play" aria-label={`播放第 ${order} 拍`}>
        <svg viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z" /></svg>
      </button>
    ) : (
      <button class="play" disabled aria-label="音频待生成" title="音频待生成">
        <svg viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z" /></svg>
      </button>
    )}
  </div>
  <div>
    <p class={`said ${human ? 'grain-real' : 'grain-ai'}`}>{line.textDialect}</p>
    <p class="trans">{line.textMandarin}</p>
    {line.note && <p class="gloss">{line.note}</p>}
    <div class="row-foot">
      <span class={`tag ${VERIFICATION_TAG_CLASS[verification]}`}>{VERIFICATION_LABELS[verification]}</span>
      <button class="wrong" type="button" disabled title="纠错功能是 Phase 2，先记着这句不对">这句不对</button>
    </div>
  </div>
</div>

<style>
  .line {
    --c: var(--ink-2);
    display: grid; grid-template-columns: 92px 1fr; gap: 22px;
    padding: 24px 0; border-bottom: 1px solid var(--rule);
    transition: background .35s ease;
  }
  .line.active { background: var(--paper); box-shadow: -14px 0 0 var(--paper), 14px 0 0 var(--paper); }
  .beat {
    font-family: var(--font-ui); font-size: 11px; letter-spacing: .12em;
    color: var(--dust); padding-top: 6px; line-height: 1.7;
  }
  .line.active .beat { color: var(--live); }
  .play {
    width: 34px; height: 34px; border-radius: 50%; margin-top: 8px;
    border: 1px solid var(--rule); background: none; color: var(--c);
    cursor: pointer; display: grid; place-items: center;
    transition: background .2s, color .2s, border-color .2s;
  }
  .play:hover:not(:disabled) { background: var(--c); border-color: var(--c); color: var(--night); }
  .play:disabled { opacity: .28; cursor: not-allowed; }
  .play:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }
  .line.active .play { background: var(--live); border-color: var(--live); color: var(--night); }
  .play svg { width: 12px; height: 12px; fill: currentColor; }

  /* 虚实语法：AI 的字发虚偏灰，真人的字锐利色实 */
  .said {
    font-family: var(--font-display); font-size: clamp(20px, 3vw, 27px); font-weight: 500;
    line-height: 1.58; color: var(--c); margin: 0 0 10px; text-wrap: balance; letter-spacing: .01em;
  }
  .line.ai .said { color: color-mix(in srgb, var(--c) 60%, var(--dust)); }
  .line.active .said { color: var(--c); opacity: 1; text-shadow: none; }

  .trans { margin: 0 0 10px; font-size: 14.5px; color: var(--ink-2); }
  /* 注释升格：悬挂缩进，不再压成灰色小字 */
  .gloss {
    font-family: var(--font-ui); margin: 0; font-size: 12.5px; color: var(--ink-2);
    padding-left: 14px; text-indent: -14px; line-height: 1.85;
  }
  .row-foot { display: flex; align-items: center; gap: 16px; margin-top: 15px; flex-wrap: wrap; }
  .tag { font-family: var(--font-ui); font-size: 10.5px; letter-spacing: .09em; color: var(--dust); }
  .tag.human { color: var(--c); font-weight: 500; }
  .wrong {
    font-family: var(--font-ui); font-size: 12.5px; background: none; border: none;
    cursor: pointer; color: var(--dust); border-bottom: 1px dashed var(--rule); padding: 0 0 2px;
  }
  .wrong:hover:not(:disabled) { color: var(--cut-lit); border-bottom-color: var(--cut-lit); }
  .wrong:disabled { opacity: .35; cursor: not-allowed; }
  .wrong:focus-visible { outline: 2px solid var(--live); outline-offset: 3px; }
</style>
