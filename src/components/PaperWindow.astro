---
import Rosette from './Rosette.astro';
---
<div class="stage">
  <div class="window-shell">
    <svg viewBox="0 0 400 424" aria-label="剪纸窗花与两个人物剪影">
      <g class="breathe"><Rosette /></g>
      <g fill="var(--cut)">
        <!-- 妈妈：叉腰 + 前指，长袍剪影，袍身镂花、下摆锯齿 -->
        <g class="figure" data-fig="mom" transform="translate(114,302) scale(0.76)">
          <ellipse cx="0" cy="-95" rx="13" ry="8" />
          <circle cx="0" cy="-76" r="20" />
          <path d="M-19,-55 L-33,-38 L-29,-24 L-15,-32 L-33,92 L33,92 L15,-32 L29,-24 L33,-38 L19,-55 Z" />
          <path
            d="M-27,-39 L-44,-14 L-22,-1"
            fill="none"
            stroke="var(--cut)"
            stroke-width="10"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M27,-39 L45,-27 L55,-31"
            fill="none"
            stroke="var(--cut)"
            stroke-width="10"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <g fill="var(--paper)">
            <path d="M0,-14 C7,-5 7,5 0,13 C-7,5 -7,-5 0,-14 Z" />
            <circle cx="-13" cy="32" r="5" />
            <circle cx="13" cy="32" r="5" />
            <path d="M0,50 C6,58 6,66 0,73 C-6,66 -6,58 0,50 Z" />
            <path d="M-33,92 l11,-12 l11,12 l11,-12 l11,12 l11,-12 l11,12 Z" />
          </g>
        </g>
        <!-- 孩子：低头缩肩，手垂在身侧 -->
        <g class="figure" data-fig="kid" transform="translate(292,304) scale(0.8)">
          <circle cx="0" cy="-60" r="17" />
          <path d="M-17,-62 a17,17 0 0 1 34,0 a17,7 0 0 0 -34,0 Z" />
          <path d="M-16,-43 L-27,-29 L-24,-17 L-12,-24 L-21,30 L21,30 L12,-24 L24,-17 L27,-29 L16,-43 Z" />
          <path d="M-21,30 L-18,88 L-6,88 L-4,48 L4,48 L6,88 L18,88 L21,30 Z" />
          <path
            d="M-25,-28 L-31,-4 L-27,12"
            fill="none"
            stroke="var(--cut)"
            stroke-width="9"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M25,-28 L31,-4 L27,12"
            fill="none"
            stroke="var(--cut)"
            stroke-width="9"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <g fill="var(--paper)">
            <path d="M0,-10 C5,-3 5,5 0,11 C-5,5 -5,-3 0,-10 Z" />
            <circle cx="0" cy="22" r="3.8" />
          </g>
        </g>
      </g>
    </svg>
    <div class="mullion"></div>
  </div>
</div>

<style>
  .stage { display: grid; place-items: center; padding: 40px 0 8px; }
  .window-shell {
    width: min(560px, 92vw); aspect-ratio: 1 / 1.06; position: relative;
    border: 14px solid var(--frame); border-radius: 3px; background: var(--paper);
    box-shadow: 0 0 0 1px rgba(0,0,0,.18), 0 40px 80px -30px rgba(0,0,0,.55), 0 0 90px var(--glow);
    overflow: hidden;
  }
  .window-shell svg { display: block; width: 100%; height: 100%; }
  .mullion { position: absolute; inset: 0; pointer-events: none; }
  .mullion::before, .mullion::after { content: ""; position: absolute; background: var(--frame); }
  .mullion::before { left: 50%; top: 0; bottom: 0; width: 9px; margin-left: -4.5px; }
  .mullion::after { top: 46%; left: 0; right: 0; height: 9px; }

  .breathe { animation: breathe 7s ease-in-out infinite; transform-origin: center; }
  @keyframes breathe {
    0%, 100% { opacity: .96; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.012); }
  }
  .figure { transition: opacity .45s ease, transform .45s ease; }
  .figure.dim { opacity: .3; }
  .figure.hot { transform: translateY(-3px) scale(1.02); }

  @media (prefers-reduced-motion: reduce) {
    .breathe { animation: none; }
    .figure { transition: none; }
  }
</style>
