---
import '../styles/tokens.css';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = '同一出戏，各地各演一遍。', noindex = false } = Astro.props;

/**
 * 全站导航。
 *
 * 2026-09-07 之前这四个入口只长在首页正文里，于是**除了首页，全站每一页都是
 * 死路**——进了 /map/ 只能退回首页，横向去不了任何地方。owner 问「是不是该
 * 做成 tab」，问的其实是这件事。
 *
 * 做成站级导航而不是「一个页面里的标签页」：这四个是四件不同的事（一个游戏、
 * 一张图、一个表单、一篇立场），不是同一份内容的四个视图。标签页的语义是
 * 「切换看同一个东西」，用在这儿会得到一个在首页没有选中项的空标签栏。
 * 视觉上它就是一排 tab（当前页带墨线），但每一项是一个真页面、有自己的 URL。
 *
 * 「录一段」单独标出来：那是这个站唯一的请求，不该跟四个去处混在一排里。
 */
const NAV = [
  { href: '/weekly/', label: '一句话挑战' },
  { href: '/guess/', label: '盲听猜方言' },
  { href: '/map/', label: '方言地图' },
  { href: '/swearing/', label: '脏话也是方言' },
] as const;

const path = Astro.url.pathname;
// 首页不重复印小报头——它正下方就是那个 82px 的大报头
const isHome = path === '/';
// startsWith 让 /record/debt/ 也算在 /record/ 上。'/' 故意不进 NAV，
// 否则它会 startsWith 匹配全站每一页。
const isCurrent = (href: string) => path === href || path.startsWith(href);
// 正式地址是 geshuo.defiabell.com（astro.config 的 site）。旧的 geshuo.pages.dev 还在服务，
// 每一页都要明说自己的正本在哪，否则搜索引擎会把两个域名当成两份内容。
const canonical = new URL(path, Astro.site).href;
// 分享卡：全站一张（public/og.png，由 scripts/og.py 生成）。微信／Slack／X 抓的是
// 绝对地址，相对路径会被当成没有。
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="各说各话" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700;900&family=Noto+Sans+SC:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="wrap">
      {/*
        样张的天头：两枚套准十字夹着导航。

        印刷厂的校色样张四角都有套准十字，用来看几色对没对齐——这个站的全部
        主张就是「对不齐」，所以它是这里最名正言顺的装饰：它有本职工作。
        导航排在两枚十字之间，于是它读起来是这张样张的边缘信息，不是内容。
        两个纯 CSS 十字，没有额外请求。
      */}
      <header class="sheet">
        <span class="mark" aria-hidden="true"></span>
        {!isHome && <a class="sw" href="/">各说各话</a>}
        <nav class="site-nav" aria-label="站内导航">
          {NAV.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="ask" href="/record/" aria-current={isCurrent('/record/') ? 'page' : undefined}>录一段</a>
        </nav>
        <span class="mark" aria-hidden="true"></span>
      </header>
      <slot />
      {/* 版权脚：这个站是 defiabell.com 下的一个项目，每页都说一声，回得去 */}
      <footer class="colophon">
        <p>作者 Jinkun · <a href="https://defiabell.com">defiabell.com</a></p>
      </footer>
    </div>
  </body>
</html>

<style>
  .colophon { margin-top: 48px; padding: 18px 0 28px; }
  .colophon p { font-family: var(--font-ui); font-size: 12px; color: var(--dust); margin: 0; }
  .colophon a { color: var(--dust); text-decoration: none; }
  .colophon a:hover { color: var(--cut-lit); }
</style>
